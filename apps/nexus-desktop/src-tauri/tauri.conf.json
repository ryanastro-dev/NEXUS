{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "identifier": "com.netmapper.app",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXUS",
        "width": 1200,
        "height": 750,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": false
      },
      {
        "label": "splash",
        "title": "NEXUS",
        "url": "splash.html",
        "width": 420,
        "height": 260,
        "resizable": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {}
  }
}
