{
  "name": "nexus-gui",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:frontend": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "smoke:runtime": "powershell -ExecutionPolicy Bypass -File ../../scripts/desktop-smoke.ps1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
